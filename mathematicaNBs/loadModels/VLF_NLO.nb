Cell[BoxData[{
 RowBox[{
  RowBox[{"Assumptions1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mSDM", " ", "\[NotEqual]", " ", "MT"}], ",", 
     RowBox[{"mPsiT", ">", 
      RowBox[{"(", 
       RowBox[{"mSDM", "+", "MT"}], ")"}]}], ",", 
     RowBox[{"xT", ">", "0"}], ",", 
     RowBox[{"xC", ">", "0"}], ",", 
     RowBox[{"lA", ">", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"Join", "[", 
