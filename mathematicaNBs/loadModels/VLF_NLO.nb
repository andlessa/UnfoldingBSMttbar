       RowBox[{"xC", "^", "2"}], " ", "-", " ", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"xT", "+", "1"}], ")"}], " ", "xC"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xT", "-", "1"}], ")"}], "^", "2"}]}], ")"}], "\[Rule]", " ",
      "lA"}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{
