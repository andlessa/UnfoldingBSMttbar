  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"subs1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MT", "\[Rule]", " ", 
      RowBox[{
       SqrtBox["xT"], " ", "mPsiT"}]}], ",", 
     RowBox[{"mSDM", "\[Rule]", " ", 
      RowBox[{
       SqrtBox["xC"], " ", "mPsiT"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"subs2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", 
