Cell[BoxData[{
 RowBox[{
  RowBox[{"su3Terms", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"c", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{"Expand", "[", "ampEsimp3", "]"}], ",", 
             RowBox[{"su3prods", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"allTerms", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"allPairs", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"c", "\[Equal]", "0"}], ",", 
       RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", " ", 
      RowBox[{"Collect", "[", 
       RowBox[{
        FractionBox["c", 
         RowBox[{"I", " ", 
          RowBox[{"Pi", "^", "2"}], " ", "gs", " ", 
          RowBox[{"yDM", "^", "2"}]}]], ",", 
        RowBox[{"{", 
         RowBox[{"MT", ",", "t", ",", "u"}], "}"}], ",", "FullSimplify"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"su3Terms", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"su3prods", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"allTerms", "[", 
          RowBox[{"[", "j", "]"}], "]"}], ",", 
         RowBox[{"allPairs", "[", 
          RowBox[{"[", "k", "]"}], "]"}], ",", "c"}], "}"}]}], "]"}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "su3prods", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", 
      RowBox[{"Length", "[", "allTerms", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", 
