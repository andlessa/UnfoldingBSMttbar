                  RowBox[{"Momentum", "[", 
                   RowBox[{"p2", ",", "D"}], "]"}]}], "]"}], "\[Rule]", "0"}],
                ",", 
               RowBox[{
                RowBox[{"Pair", "[", 
                 RowBox[{
                  RowBox[{"LorentzIndex", "[", 
                   RowBox[{"\[Mu]", ",", "D"}], "]"}], ",", 
                  RowBox[{"Momentum", "[", 
                   RowBox[{"p1", ",", "D"}], "]"}]}], "]"}], "\[Rule]", 
                "0"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"su3prods", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"allTerms", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"c", "\[Equal]", "0"}], ",", 
       RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", " ", 
      RowBox[{"Collect", "[", 
       RowBox[{
        FractionBox["c", 
         RowBox[{"I", " ", 
          RowBox[{"Pi", "^", "2"}], " ", "gs", " ", 
          RowBox[{"yDM", "^", "2"}]}]], ",", 
        RowBox[{"{", 
         RowBox[{"MT", ",", "t", ",", "u"}], "}"}], ",", "FullSimplify"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"su3Terms", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"su3prods", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"allTerms", "[", 
          RowBox[{"[", "j", "]"}], "]"}], ",", "1", ",", "c"}], "}"}]}], 
      "]"}], ";"}], "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
