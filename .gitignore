# ---------------------------------------------------------------- Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
# MadGraph model cache written into UFO folders
*.pkl

# ---------------------------------------------------------------- generated data
/data/
*.lhe
*.lhe.gz
*.h5
*.npz

# ---------------------------------------------------------------- backup (kept only locally)
/backup/

# ---------------------------------------------------------------- MadGraph process folders
# Track only what is needed to regenerate the folders: the cards and the bias functions
# of the event-generation folders, and the build script + README of the MatrixElements.
# Everything compiled or generated by MadGraph is ignored.
/processFolders/**
!/processFolders/**/
!/processFolders/README.md
!/processFolders/build_matrix_elements.py
!/processFolders/**/Cards/proc_card_mg5.dat
!/processFolders/**/Cards/param_card.dat
!/processFolders/**/Cards/run_card.dat
!/processFolders/**/Cards/FKS_params.dat
!/processFolders/**/Cards/FO_analyse_card.dat
!/processFolders/**/*.mg5
!/processFolders/**/Source/mtt_bias_NLO.f
!/processFolders/**/Source/BIAS/mtt_bias/mtt_bias.f
!/processFolders/**/Source/BIAS/mtt_bias/makefile
# not inside the matrix-element libraries (regenerated by build_matrix_elements.py),
# not in run outputs or backups made by MadGraph or by the bias patch
/processFolders/**/MatrixElements/
/processFolders/**/Events/
/processFolders/**/.backup*/
/processFolders/Distributions/
