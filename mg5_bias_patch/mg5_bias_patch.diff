+    def fo_lhe_unbiased_total(self, jobs):
+        """PATCH (bias): physical total cross section of a biased fixed-order run with LHE output.
+        Each job's events.lhe ends with 'nevents sum_w cross sum_w*bias' (cross = biased integral,
+        event weights with the bias divided out), so sigma_job = cross*sum_w/sum_(w*bias).
+        Returns (total, error) or None if the information is not available."""
+        if self.run_card['event_norm'].lower() != 'bias':
+            return None
+        total, var = 0., 0.
+        for job in jobs:
+            path = pjoin(job['dirname'], 'events.lhe')
+            if not os.path.exists(path):
+                return None
+            vals = [float(i) for i in misc.BackRead(path).readline().split()]
+            if len(vals) < 4 or vals[2] == 0 or vals[3] == 0:
+                return None
+            sigma = vals[2]/vals[3]*vals[1]
+            total += sigma
+            var += (job['error']*sigma/vals[2])**2
+        return total, math.sqrt(var)
