BLOCK SModelS_Settings
 0  v3.1.1                    #SModelS version
 1  3.1.1                     #database version
 2  0.2                       #maximum condition violation
 3  1                         #compression (0 off, 1 on)
 4  5.                        #minimum mass gap for mass compression [GeV]
 5  0.000005                  #sigmacut [fb]
 6  1                         #signal region combination (0 off, 1 on)
 7  0                         #analyses combination (0 off, 1 on)
 8  1e-11                     #prompt width [GeV] 
 9  1e-25                     #stable width [GeV] 

BLOCK SModelS_Exclusion
 0 0 0                              #output status (-1 not tested, 0 not excluded, 1 excluded)
 1 0 T2bbffff                       #txname (final states = PV > (b,jet,jet,MET),(b,jet,jet,MET))
 1 1 8.338E-01                      #r value
 1 2 6.596E-01                      #expected r value
 1 3 0.00                           #condition violation
 1 4 ATLAS-SUSY-2018-12             #analysis
 1 5 (UL)                           #signal region 
 1 6 N/A                            #nll
 1 7 N/A                            #nll_min
 1 8 N/A                            #nll_SM

 2 0 T2ttC                          #txname (final states = PV > (b,jet,jet,MET),(b,jet,jet,MET))
 2 1 7.441E-01                      #r value
 2 2 9.791E-01                      #expected r value
 2 3 0.00                           #condition violation
 2 4 CMS-SUS-19-010                 #analysis
 2 5 (UL)                           #signal region 
 2 6 N/A                            #nll
 2 7 N/A                            #nll_min
 2 8 N/A                            #nll_SM


BLOCK SModelS_Coverage
 0 0 missing (all)                       # missing topologies
 0 1 0.000E+00                           # Total cross-section (fb)
 1 0 missing (displaced)                 # missing topologies with displaced decays
 1 1 0.000E+00                           # Total cross-section (fb)
 2 0 missing (prompt)                    # missing topologies with prompt decays
 2 1 0.000E+00                           # Total cross-section (fb)
 3 0 outsideGrid (all)                   # topologies outside the grid
 3 1 4.312E+01                           # Total cross-section (fb)
